{
  "$schema": "https://githubusercontent.com",
  "version": 4,
  "async": true,
  "final_space": true,
  "shell_integration": true,
  "enable_cursor_positioning": true,
  "console_title_template": "{{ if .Root }}[Admin] {{ end }}{{ if .SSHSession }}[SSH:{{ .HostName }}] {{ end }}{{ .Shell }} · {{ .Folder }}",
  "palette": {
    "path": "#CCCAC2",
    "accent": "#73D0FF",
    "bracket": "#9E7A47",
    "folder": "#FFCC66",
    "folder_error": "#FF857A",
    "folder_icon": "#B88B4D",
    "folder_icon_error": "#D95757",
    "clean": "#87D96C",
    "changed": "#F29E74",
    "error": "#F28779",
    "info": "#5CCFE6",
    "rust": "#DEA584",
    "cpp": "#DFBFFF",
    "muted": "#707A8C",
    "rail": "#4A5368"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "foreground_templates": [
      "{{ if ne .Code 0 }}p:error{{ end }}"
    ],
    "template": "\u276f ",
    "newline": false
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:bracket",
    "template": "│ <p:muted>\u276f</> "
  },
  "tooltips_action": "prepend",
  "tooltips": [
    {
      "type": "kubectl",
      "tips": [
        "kubectl",
        "k",
        "helm"
      ],
      "style": "plain",
      "foreground": "p:info",
      "template": " \udb84\udcfe {{ .Context }}{{ if .Namespace }}:{{ .Namespace }}{{ end }} <p:rail>┆</> "
    },
    {
      "type": "aws",
      "tips": [
        "aws",
        "terraform",
        "tf"
      ],
      "style": "plain",
      "foreground": "p:changed",
      "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} <p:rail>┆</> "
    },
    {
      "type": "docker",
      "tips": [
        "docker",
        "docker-compose"
      ],
      "style": "plain",
      "foreground": "p:accent",
      "template": " \uf308 {{ .Context }} <p:rail>┆</> "
    }
  ],
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:bracket",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:error{{ end }}"
          ],
          "template": "╭─ "
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:path",
          "options": {
            "windows": "\ue62a",
            "macos": "\uf179",
            "linux": "\uf17c",
            "ubuntu": "\uf31b",
            "debian": "\uf306",
            "raspbian": "\uf315",
            "arch": "\uf303",
            "fedora": "\uf30a",
            "centos": "\uf304",
            "redhat": "\uf316",
            "alpine": "\uf300",
            "nixos": "\uf313",
            "manjaro": "\uf312",
            "opensuse": "\uf314"
          },
          "template": "{{ .Icon }}"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:muted",
          "foreground_templates": [
            "{{ if .Root }}p:error{{ else if .SSHSession }}p:info{{ end }}"
          ],
          "template": "{{ if .Root }} \uf21b admin{{ else if .SSHSession }} \udb80\udcc0 {{ .UserName }}@{{ if gt (len .HostName) 10 }}{{ trunc 9 .HostName }}…{{ else }}{{ .HostName }}{{ end }}{{ else }} {{ .UserName }}@{{ if gt (len .HostName) 8 }}{{ trunc 7 .HostName }}…{{ else }}{{ .HostName }}{{ end }}{{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:folder",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:folder_error{{ end }}"
          ],
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "home_icon": "~",
            "folder_separator_icon": "<p:muted>/</>",
            "left_format": "<p:muted>%s</>",
            "folder_format": "<p:muted>%s</>",
            "right_format": "%s"
          },
          "template": " <p:rail>┆</> {{ if ne .Code 0 }}<p:folder_icon_error>\uf07b</>{{ else }}<p:folder_icon>\uf07b</>{{ end }} {{ if not (contains \"/\" .Path) }}{{ if ne .Code 0 }}<p:folder_error>{{ .Path }}</>{{ else }}<p:folder>{{ .Path }}</>{{ end }}{{ else }}{{ .Path }}{{ end }}{{ if eq .Env.OS \"Windows_NT\" }}{{ if and (not .Root) (matchP \"(?i)^[a-z]:[/\\\\\\\\](Windows|Program Files( \\\\(x86\\\\))?|ProgramData)([/\\\\\\\\]|$)\" .Location) }} <p:error>\uf023</>{{ end }}{{ else if not .Writable }} <p:error>\uf023</>{{ end }}"
        },
        {
          "type": "git",
          "style": "plain",
          "min_width": 75,
          "foreground": "p:clean",
          "foreground_templates": [
            "{{ if or (gt .Working.Unmerged 0) (gt .Staging.Unmerged 0) }}p:error{{ else if or .Working.Changed .Staging.Changed }}p:changed{{ else if gt .Behind 0 }}p:info{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "native_fallback": true,
            "untracked_modes": {
              "*": "normal"
            },
            "branch_max_length": 24,
            "truncate_symbol": "…",
            "branch_icon": "\ue0a0 ",
            "commit_icon": "\uf417 ",
            "tag_icon": "\uf412 "
          },
          "template": " <p:rail>┆</> {{ if .UpstreamIcon }}{{ .UpstreamIcon }} {{ end }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} <p:clean>{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <p:changed>{{ .Working.String }}</>{{ end }}"
        },
        {
          "type": "rust",
          "style": "plain",
          "min_width": 85,
          "foreground": "p:rust",
          "cache": {
            "duration": "15m",
            "strategy": "folder"
          },
          "options": {
            "display_mode": "files",
            "extensions": [
              "*.rs",
              "Cargo.toml",
              "rust-toolchain.toml"
            ]
          },
          "template": " <p:rail>┆</> \ue7a8 {{ .Full }}"
        },
        {
          "type": "cmake",
          "style": "plain",
          "min_width": 90,
          "foreground": "p:cpp",
          "cache": {
            "duration": "15m",
            "strategy": "folder"
          },
          "options": {
            "display_mode": "files",
            "extensions": [
              "CMakeLists.txt",
              "*.cmake",
              "Makefile",
              "meson.build",
              "*.c",
              "*.cpp",
              "*.cc",
              "*.h",
              "*.hpp"
            ]
          },
          "template": " <p:rail>┆</> \ue61d {{ if .Full }}cmake {{ .Major }}.{{ .Minor }}{{ else }}C/C++{{ end }}"
        },
        {
          "type": "python",
          "style": "plain",
          "min_width": 85,
          "foreground": "p:info",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": true,
            "display_default": false,
            "extensions": [
              "*.py",
              "pyproject.toml",
              "uv.lock",
              "requirements.txt"
            ]
          },
          "template": " <p:rail>┆</> \ue73c {{ if .Venv }}{{ .Venv }}{{ else }}{{ .Major }}.{{ .Minor }}{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": " "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "filler": "<p:rail>┄</>",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "min_width": 60,
          "foreground": "p:info",
          "template": "{{ if gt .Jobs 0 }} \uf013 {{ .Jobs }} <p:rail>┆</>{{ end }}"
        },
        {
          "type": "status",
          "style": "plain",
          "min_width": 60,
          "foreground": "p:error",
          "options": {
            "always_enabled": false
          },
          "template": " \uf00d {{ .Code }} <p:rail>┆</>"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "min_width": 60,
          "foreground": "p:changed",
          "options": {
            "always_enabled": false,
            "style": "austin",
            "threshold": 500
          },
          "template": " \uf252 {{ .FormattedMs }} <p:rail>┆</>"
        },
        {
          "type": "time",
          "style": "plain",
          "min_width": 50,
          "foreground": "p:path",
          "options": {
            "time_format": "15:04"
          },
          "template": " {{ if ne .Code 0 }}<p:error>\uf017</>{{ else }}<p:bracket>\uf017</>{{ end }} {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:bracket",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:error{{ end }}"
          ],
          "template": "─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:bracket",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:error{{ end }}"
          ],
          "template": "╰─ "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:clean",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:error{{ end }}"
          ],
          "template": "\udb83\uddbb"
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hide",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "min_width": 50,
          "foreground": "p:bracket",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:error{{ end }}"
          ],
          "template": "─╯"
        }
      ]
    }
  ]
}
